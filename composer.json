{
    "name": "michaeldrennen/balcony-ici-flow-scraper",
    "description": "Scraper for ICI weekly money market fund asset releases in The Balcony macro flow system",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Drennen",
            "homepage": "https://github.com/michaeldrennen"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "suggest": {
        "illuminate/database": "Required to use bundled Eloquent models (^10.0|^11.0|^12.0)"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MichaelDrennen\\Balcony\\IciFlowScraper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MichaelDrennen\\Balcony\\IciFlowScraper\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
